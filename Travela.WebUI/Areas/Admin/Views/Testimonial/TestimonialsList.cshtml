@model List<ResultTestimonialDto>

@{
    ViewData["Title"] = "TestimonialsList";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
    int counter = 0;
}


<div class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <div class="white_shd full margin_bottom_30">
                    <div class="full graph_head">
                        <div class="heading1 margin_0">
                            <h2>Referanslar Listesi</h2>
                        </div>
                    </div>
                    <div class="table_section padding_infor_info">
                        <div class="table-responsive-sm">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr style="color:black; vertical-align:middle;">
                                        <th>#</th>
                                        <th>Adı Soyadı</th>
                                        <th>Yorum İçeriği</th>
                                        <th>Yorumcunun Şehri</th>
                                        <th>Yorumcunun Ülkesi</th>
                                        <th>Yorumcunun Puanı</th>
                                        <th>Görsel</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model)
                                    {
                                        counter++;

                                        <tr style="color:black;">
                                            <td style="vertical-align:middle;">@counter</td>
                                            <td style="vertical-align:middle;">@item.NameSurname</td>
                                            <td style="vertical-align:middle;">@item.Comment</td>
                                            <td style="vertical-align:middle;">@item.CommenterLocation</td>
                                            <td style="vertical-align:middle;">@item.Country</td>
                                            <td style="vertical-align:middle;">
                                                @for (int i = 0; i < 5; i++)
                                                {
                                                    @if (i < item.CountStar)
                                                    {
                                                        <i class="fa fa-star" style="color: gold;"></i>
                                                    }   
                                                    else
                                                    {
                                                         <i class="fa fa-star-o" style="color: lightgray;"></i>
                                                    }
                                                } 
                                                (@item.CountStar Puan)
                                            </td style="vertical-align:middle;">
                                            <td style="vertical-align:middle;"><image src="@item.ImageUrl" style="width:150px;height:150px;"></image></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
