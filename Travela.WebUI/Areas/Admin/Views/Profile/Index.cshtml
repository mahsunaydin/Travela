@model LoginUserInfoModel

@{
    ViewData["Title"] = "Index";
    Layout = "~/Areas/Admin/Views/AdminLayout/Index.cshtml";
}

<div class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-8">
                <div class="white_shd full margin_bottom_30">
                    <div class="full price_table padding_infor_info">
                        <div class="row">
                            <!-- user profile section -->
                            <!-- profile image -->
                            <div class="col-lg-12">
                                <div class="full dis_flex center_text">
                                    <div class="profile_img"><img width="180" class="rounded-circle" src="~/pluto/images/layout_img/profilePhoto.jpg" alt="#" /></div>
                                    <div class="profile_contant">
                                        <div class="contact_inner">
                                            <h3>@Model.Name @Model.Surname</h3>
                                            <p><strong>Hakkında: </strong>Full Stack Developer</p>
                                            <ul class="list-unstyled">
                                                <li><i class="fa fa-envelope-o"></i> : @Model.Mail</li>
                                                <li><i class="fa fa-phone"></i> :@Model.PhoneNumber</li>
                                            </ul>
                                        </div>
                                    </div>
                                </div>

                                <!-- Test yapılıyor Mahsun -->
                                <form method="post">
                                    <label>Kullanıcı Adı</label>
                                    <input tpye="text" class="form-control" asp-for="@Model.Username" />
                                    <br />
                                    <label>Adı</label>
                                    <input tpye="text" class="form-control" asp-for="@Model.Name" />
                                    <br />
                                    <label>Soyadı</label>
                                    <input tpye="text" class="form-control" asp-for="@Model.Surname" />
                                    <br />
                                    <label>Mail</label>
                                    <input tpye="text" class="form-control" asp-for="@Model.Mail" />
                                    <br />
                                </form>

                                <!-- profile contant section -->
                                
                                <!-- end user profile section -->
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>