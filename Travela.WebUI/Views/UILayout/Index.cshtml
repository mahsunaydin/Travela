

<!DOCTYPE html>
<html lang="tr">

@await Component.InvokeAsync("_UILayoutHeadComponent")

<body>

    <!-- Spinner Start -->
    <div id="spinner" class="show bg-white position-fixed translate-middle w-100 vh-100 top-50 start-50 d-flex align-items-center justify-content-center">
        <div class="spinner-border text-primary" style="width: 3rem; height: 3rem;" role="status">
            <span class="sr-only">Yükleniyor...</span>
        </div>
    </div>
    <!-- Spinner End -->


    <!-- Topbar Start -->
    @await Component.InvokeAsync("_UILayoutTopbarComponent")
    <!-- Topbar End -->


    <!-- Navbar & Hero Start -->

    @RenderBody()


    <!-- Footer Start -->
    @await Component.InvokeAsync("_UILayoutFooterComponent")
    <!-- Footer End -->


    <!-- Copyright Start -->
    <div class="container-fluid copyright text-body py-4">
        <div class="container">
            <div class="row g-4 align-items-center">
                <div class="col-md-6 text-center text-md-end mb-md-0">
                    <i class="fas fa-copyright me-2"></i><a class="text-white" href="#">Travela</a>, Tüm hakları saklıdır.
                </div>
                <div class="col-md-6 text-center text-md-start">
                    Designed By <a class="text-white" href="https://htmlcodex.com">Mahsun AYDIN</a>  <a href="https://themewagon.com">Tasarım</a>
                </div>
            </div>
        </div>
    </div>
    <!-- Copyright End -->


    <!-- Back to Top -->
    <a href="#" class="btn btn-primary btn-primary-outline-0 btn-md-square back-to-top"><i class="fa fa-arrow-up"></i></a>


    <!-- JavaScript Libraries -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.4/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/travela-1.0.0/lib/easing/easing.min.js"></script>
    <script src="/travela-1.0.0/lib/waypoints/waypoints.min.js"></script>
    <script src="/travela-1.0.0/lib/owlcarousel/owl.carousel.min.js"></script>
    <script src="/travela-1.0.0/lib/lightbox/js/lightbox.min.js"></script>


    <!-- Template Javascript -->
    <script src="/travela-1.0.0/js/main.js"></script>
</body>

</html>
