@model Travela.WebUI.Dtos.UpdateCategoryDto
@{
    Layout = null;
}

<link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />

<form method="post">
    <div class="container">
        <br /><br />

        <input type="hidden" asp-for="categoryId" class="form-control"/>

        <label>Kategori Adı</label>
        <input type="text" asp-for="categoryName" class="form-control" />
        <br />

        <label>Kategori Görsel</label>
        <input type="text" asp-for="imageUrl" class="form-control" />
        <br />

        <button class="btn btn-primary">Kategoriyi Güncelle</button>    
        
    </div>
</form>
