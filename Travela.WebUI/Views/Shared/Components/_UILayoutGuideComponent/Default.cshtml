@model List<ResultGuideDto>

<div class="container-fluid guide py-5">
    <div class="container py-5">
        <div class="mx-auto text-center mb-5" style="max-width: 900px;">
            <h5 class="section-title px-3">Seyahat Rehberleri</h5>
            <h1 class="mb-0">Rehberlerimizle Tanışın</h1>
        </div>
        <div class="row g-4">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-3">
                    <div class="guide-item">
                        <div class="guide-img">
                            <div class="guide-img-efects">

                                <img src="@item.ImageUrl" class="img-fluid w-100 rounded-top" alt="Image" style="width:112px;height:420px;">
                            </div>
                            <div class="guide-icon rounded-pill p-2">
                                <a class="btn btn-square btn-primary rounded-circle mx-1" href="@item.facebookUrl"><i class="fab fa-facebook-f"></i></a>
                                <a class="btn btn-square btn-primary rounded-circle mx-1" href="@item.twitterUrl"><i class="fab fa-twitter"></i></a>
                                <a class="btn btn-square btn-primary rounded-circle mx-1" href="@item.instagramUrl"><i class="fab fa-instagram"></i></a>
                                <a class="btn btn-square btn-primary rounded-circle mx-1" href="@item.linkedinUrl"><i class="fab fa-linkedin-in"></i></a>
                            </div>
                        </div>
                        <div class="guide-title text-center rounded-bottom p-4">
                            <div class="guide-title-inner">
                                <h4 class="mt-3">@item.GuideNameSurname</h4>
                                <p class="mb-0">@item.Designation</p>
                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>