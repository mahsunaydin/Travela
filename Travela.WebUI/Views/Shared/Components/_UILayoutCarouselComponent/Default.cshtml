@model List<ResultCarouselDto>

<div class="carousel-header">
    <div id="carouselId" class="carousel slide" data-bs-ride="carousel">
        <ol class="carousel-indicators">
            @for (int i = 0; i < Model.Count; i++) // active sınıfın eklenmesi için kontrol yapılıyor
            {
                if(i == 0)
                {
                    <li data-bs-target="#carouselId" data-bs-slide-to="@i" class="active"></li>
                }
                else
                {
                    <li data-bs-target="#carouselId" data-bs-slide-to="@i"></li>
                }
                
            }
        </ol>

        <div class="carousel-inner" role="listbox">
            @for (int i = 0; i < Model.Count; i++) //active sınıfının seçilmesi için döngü içinde kontrol yapılıyor
            {
                var item = Model[i];
                if (i == 0)
                {
                    <div class="carousel-item active">
                        <img src="@item.imageUrl" class="img-fluid" alt="Image">
                        <div class="carousel-caption">
                            <div class="p-3" style="max-width: 900px;">
                                <h4 class="text-white text-uppercase fw-bold mb-4" style="letter-spacing: 3px;">@item.Title</h4>
                                <h1 class="display-2 text-capitalize text-white mb-4">@item.Title1</h1>
                                <p class="mb-5 fs-5">
                                    @item.Subtitle
                                </p>
                                <div class="d-flex align-items-center justify-content-center">
                                    <a class="btn-hover-bg btn btn-primary rounded-pill text-white py-3 px-5" href="#">Şimdi Keşfet</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <div class="carousel-item">
                        <img src="@item.imageUrl" class="img-fluid" alt="Image">
                        <div class="carousel-caption">
                            <div class="p-3" style="max-width: 900px;">
                                <h4 class="text-white text-uppercase fw-bold mb-4" style="letter-spacing: 3px;">@item.Title</h4>
                                <h1 class="display-2 text-capitalize text-white mb-4">@item.Title1</h1>
                                <p class="mb-5 fs-5">
                                    @item.Subtitle
                                </p>
                                <div class="d-flex align-items-center justify-content-center">
                                    <a class="btn-hover-bg btn btn-primary rounded-pill text-white py-3 px-5" href="#">Şimdi Keşfet</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }

        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#carouselId" data-bs-slide="prev">
            <span class="carousel-control-prev-icon btn bg-primary" aria-hidden="false"></span>
            <span class="visually-hidden">Geri</span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#carouselId" data-bs-slide="next">
            <span class="carousel-control-next-icon btn bg-primary" aria-hidden="false"></span>
            <span class="visually-hidden">İleri</span>
        </button>
    </div>
</div>
