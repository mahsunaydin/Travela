@model List<ResultServiceDto>

<div class="container-fluid bg-light service py-5">
    <div class="container py-5">
        <div class="mx-auto text-center mb-5" style="max-width: 900px;">
            <h5 class="section-title px-3">Hizmetler</h5>
            <h1 class="mb-0">Hizmetlerimiz</h1>
        </div>

        <div class="row g-4">
            <div class="col-lg-6">
                <div class="row g-4">

                    @foreach (var item in Model)
                    {
                        @if (item.ServiceId % 2 == 1)
                        {
                            <div class="col-12">

                                <div class="service-content-inner d-flex align-items-center justify-content-end bg-white border border-primary rounded p-4 pe-0">
                                    <div class="service-content text-end">
                                        <h5 class="mb-4">@item.Title</h5>
                                        <p class="mb-0">
                                            @item.Description
                                        </p>
                                    </div>
                                    <div class="service-icon p-4">
                                        <i class="@item.IconUrl"></i>
                                    </div>
                                </div>
                            </div>
                        }
                    }

                </div>
            </div>
            <div class="col-lg-6">
                <div class="row g-4">

                    @foreach (var item in Model)
                    {
                        @if (item.ServiceId % 2 == 0)
                        {
                            <div class="col-12">

                                <div class="service-content-inner d-flex align-items-center justify-content-start bg-white border border-primary rounded p-4 ps-0">
                                    <div class="service-icon p-4">
                                        <i class="@item.IconUrl"></i>
                                    </div>
                                    <div class="service-content">
                                        <h5 class="mb-4">@item.Title</h5>
                                        <p class="mb-0">
                                            @item.Description
                                        </p>
                                    </div>
                                </div>
                            </div>
                        }
                    }

                </div>
            </div>

        </div>
    </div>
</div>